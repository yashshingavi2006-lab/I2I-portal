# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings -> API -> service_role key. NEVER expose this to the browser or
# commit it. Used only in server-side code (app/api/register, admin actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed site URL (used for email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notification queue (registration emails, phase updates, etc.) ---
# Which provider lib/notifications uses. "resend" (default) or "smtp".
EMAIL_PROVIDER=resend

# Required if EMAIL_PROVIDER=resend. Get from resend.com — free tier covers
# far more than 800 sends. Sign up, verify a sending domain, create an API key.
RESEND_API_KEY=your-resend-api-key

# Required if EMAIL_PROVIDER=smtp instead (Google Workspace/Gmail).
# SMTP_APP_PASSWORD is a Google "App Password", not your normal login password.
SMTP_USER=your-address@gmail.com
SMTP_APP_PASSWORD=your-app-password

# The "from" address/name shown on outgoing emails.
NOTIFICATION_FROM_EMAIL=I2I Portal <noreply@your-verified-domain.com>

# Shared secret so only your scheduled job can trigger
# /api/notifications/process. Make up any long random string.
# IMPORTANT: something external MUST call this endpoint on a schedule (e.g.
# every 1-5 minutes) with header "Authorization: Bearer <this value>", or
# queued emails will sit unsent forever. See README/deployment notes.
CRON_SECRET=make-up-a-long-random-string
